rules_version = '2';
// O front NÃO acessa o Firestore direto: tudo passa pelo servidor Express (Admin SDK ignora estas regras).
// Por isso negamos qualquer acesso de cliente. Isso protege estoque, pedidos e dados pessoais (LGPD).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
